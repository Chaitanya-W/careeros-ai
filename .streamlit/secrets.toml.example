# CareerOS AI — Streamlit Secrets (EXAMPLE TEMPLATE)
# ------------------------------------------------------------
# 1. Copy this file:   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# 2. Fill in real values.
# 3. NEVER commit the real `secrets.toml` (it is git-ignored).
#
# Values are surfaced inside Streamlit via `st.secrets["..."]`.
# See: https://docs.streamlit.io/develop/concepts/secrets

# ---- Gemini (Resume Intelligence) — REQUIRED for AI analysis ----
# The API key is read by src/services/gemini.py::get_api_key().
# Get a key from: https://aistudio.google.com/apikey
[gemini]
api_key = "your-gemini-api-key-here"
# model = "gemini-3.6-flash"      # optional; overrides the default

# Alternatively, set GEMINI_API_KEY (or GOOGLE_API_KEY) in your environment.
# The key is NEVER hardcoded in source, printed, or logged.

# ---- Language Model provider (placeholder — not yet wired) ----
# [llm]
# provider = "openai"          # or "anthropic", "azure_openai", "local"
# api_key  = "sk-..."
# model    = "gpt-4o-mini"
# temperature = 0.2
# max_tokens  = 1024

# ---- Retrieval / vector store (placeholder — not yet wired) ----
# [rag]
# vector_store = "chroma"       # or "faiss", "qdrant"
# persist_dir  = "data/vectorstore"
# embedding_model = "text-embedding-3-small"

# ---- Voice AI Interview (placeholder — not yet wired) ----
# [voice]
# stt_provider = "whisper"
# tts_provider = "openai-tts"

# ---- Application / telemetry (placeholder — not yet wired) ----
# [app]
# environment = "development"   # or "production"
